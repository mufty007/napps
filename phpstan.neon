includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - modules
        - database/seeders
    tmpDir: storage/framework/cache/phpstan
    # Read casts() so enum and date casts are typed (Laravel 11+ style).
    parseModelCastsMethod: true
    # Module tables: list each module's migrations so model columns are known.
    databaseMigrationsPath:
        - database/migrations
        - modules/Membership/database/migrations
        - modules/Fees/database/migrations
        - modules/Community/database/migrations
        - modules/Announcements/database/migrations
        - modules/Claims/database/migrations
        - modules/Templates/database/migrations
        - modules/Surveys/database/migrations
